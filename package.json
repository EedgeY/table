{
	"name": "@tarbo-table/ui",
	"version": "0.1.0",
	"description": "React UI components for tarbo-table (Supabase風 DataTable, filter/sort bar, multi-level headers, CSV export).",
	"homepage": "https://github.com/EedgeY/table#readme",
	"bugs": "https://github.com/EedgeY/table/issues",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/EedgeY/table.git",
		"directory": "packages/ui"
	},
	"files": [
		"dist",
		"src/styles.css"
	],
	"type": "module",
	"sideEffects": [
		"./dist/styles.css",
		"./src/styles.css"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./styles.css": "./src/styles.css",
		"./package.json": "./package.json"
	},
	"dependencies": {
		"@radix-ui/react-checkbox": "^1.1.3",
		"@radix-ui/react-dialog": "^1.1.4",
		"@radix-ui/react-dropdown-menu": "^2.1.4",
		"@radix-ui/react-popover": "^1.1.4",
		"@radix-ui/react-slot": "^1.1.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^0.471.0",
		"tailwind-merge": "^3.0.0"
	},
	"peerDependencies": {
		"@tarbo-table/core": "git+https://github.com/EedgeY/table.git#dist-core",
		"@tarbo-table/core-rs": "git+https://github.com/EedgeY/table.git#dist-core-rs",
		"nuqs": "^2.4.3",
		"react": "^19.1.0",
		"react-dom": "^19.1.0"
	},
	"peerDependenciesMeta": {
		"@tarbo-table/core-rs": {
			"optional": true
		},
		"nuqs": {
			"optional": true
		}
	}
}
