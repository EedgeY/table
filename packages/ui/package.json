{
	"name": "@tarbo-table/ui",
	"version": "0.1.0",
	"description": "React UI components for tarbo-table (Supabase風 DataTable, filter/sort bar, multi-level headers, CSV export).",
	"homepage": "https://github.com/EedgeY/table#readme",
	"bugs": "https://github.com/EedgeY/table/issues",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/EedgeY/table.git",
		"directory": "packages/ui"
	},
	"files": [
		"dist",
		"src/styles.css"
	],
	"type": "module",
	"sideEffects": [
		"./dist/styles.css",
		"./src/styles.css"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./styles.css": "./src/styles.css",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsgo --noEmit",
		"test:parallel:vitest": "TZ=UTC vitest run",
		"test": "pnpm --parallel --aggregate-output /^test:parallel:/",
		"lint": "eslint --cache .",
		"prepack": "pnpm run build && clean-pkg-json",
		"prerelease": "pnpm run lint && pnpm run typecheck && pnpm run build"
	},
	"dependencies": {
		"@radix-ui/react-checkbox": "catalog:radix",
		"@radix-ui/react-dialog": "catalog:radix",
		"@radix-ui/react-dropdown-menu": "catalog:radix",
		"@radix-ui/react-popover": "catalog:radix",
		"@radix-ui/react-slot": "catalog:radix",
		"class-variance-authority": "catalog:ui",
		"clsx": "catalog:ui",
		"lucide-react": "catalog:ui",
		"tailwind-merge": "catalog:ui"
	},
	"devDependencies": {
		"@tarbo-table/core": "workspace:*",
		"@tarbo-table/core-rs": "workspace:*",
		"@testing-library/react": "catalog:tooling-react",
		"@types/node": "catalog:types",
		"@types/react": "catalog:react",
		"@types/react-dom": "catalog:react",
		"@typescript/native-preview": "catalog:types",
		"clean-pkg-json": "catalog:release",
		"eslint": "catalog:lint",
		"jsdom": "catalog:tooling-react",
		"nuqs": "catalog:url-state",
		"publint": "catalog:lint",
		"react": "catalog:react",
		"react-dom": "catalog:react",
		"tsdown": "catalog:build",
		"vitest": "catalog:testing"
	},
	"peerDependencies": {
		"@tarbo-table/core": "workspace:*",
		"@tarbo-table/core-rs": "workspace:*",
		"nuqs": "catalog:url-state",
		"react": "catalog:react",
		"react-dom": "catalog:react"
	},
	"peerDependenciesMeta": {
		"@tarbo-table/core-rs": {
			"optional": true
		},
		"nuqs": {
			"optional": true
		}
	}
}
