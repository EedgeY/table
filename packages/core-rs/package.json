{
	"name": "@tarbo-table/core-rs",
	"version": "0.1.0",
	"private": false,
	"description": "Rust→WebAssembly engine for @tarbo-table/core (filter, sort, pagination).",
	"homepage": "https://github.com/EedgeY/table#readme",
	"bugs": "https://github.com/EedgeY/table/issues",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/EedgeY/table.git",
		"directory": "packages/core-rs"
	},
	"files": [
		"src",
		"pkg-node",
		"pkg-web",
		"pkg-node-image",
		"pkg-web-image"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./src/index.ts",
			"node": "./src/node.ts",
			"browser": "./src/web.ts",
			"default": "./src/web.ts"
		},
		"./node": "./src/node.ts",
		"./web": "./src/web.ts",
		"./react": "./src/react.ts",
		"./image": "./src/image.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "bash ./scripts/build-wasm.sh",
		"test:parallel:vitest": "TZ=UTC vitest run",
		"test:parallel:cargo": "cargo test --manifest-path Cargo.toml",
		"test": "pnpm --parallel --aggregate-output /^test:parallel:/",
		"bench": "node --experimental-strip-types --experimental-transform-types --no-warnings ./bench/bench.ts",
		"typecheck": "tsgo --noEmit",
		"lint": "eslint --cache ."
	},
	"devDependencies": {
		"@tarbo-table/core": "workspace:*",
		"@types/node": "catalog:types",
		"@types/react": "catalog:react",
		"@typescript/native-preview": "catalog:types",
		"eslint": "catalog:lint",
		"react": "catalog:react"
	},
	"peerDependencies": {
		"react": "catalog:react"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		}
	}
}
